  },
  {
    "id": "f089767f20b60641a108",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/monk/7/levels/17/0/d",
    "source": "Spend 5 ki for the complete astral body: +2 AC and an extra Arms attack when taking the Attack action.",
    "sourceHash": "5d9a25a9ec2f5fa1d1705510a553b25190bb5b6f057e5d1c0a5f0b47825c4a9c"
