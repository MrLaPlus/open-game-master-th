    "pointer": "/classes/monk/8/levels/6/0/n",
    "source": "Wings Unfurled",
    "sourceHash": "fc0928bc344dddbd7ae69b7d04cb11b876d0696f7b4c430621e89606d361e168"
  },
  {
    "id": "f4b7cf7d265f65a9930f",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/monk/8/levels/6/0/d",
    "source": "When you use Step of the Wind, spectral wings give you a flying speed equal to your walking speed until the end of the turn; a proficiency-bonus number of times per long rest.",
