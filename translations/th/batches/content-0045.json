    "sourceHash": "ac1197424ce7771be6e2460f3fce25dd01c1a1dfb9adbf659d66e7e9dbec1d0f"
  },
  {
    "id": "5f73cf6b1b3b992784f5",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/monk/8/levels/3/0/n",
