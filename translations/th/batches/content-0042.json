    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/5/levels/3/1/d",
    "source": "Make one extra melee attack from your echo's space when you take the Attack action, a Constitution-modifier number of times per long rest.",
    "sourceHash": "47ba82e36b0bf97958336362b2e076cd5eef7a1652ceefe5bd3f929193015c1a"
  },
