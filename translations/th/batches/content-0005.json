  },
  {
    "id": "d868511cdb102a46fc27",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/0/desc",
    "source": "Increase your Strength or Dexterity by 1, to a maximum of 20. Standing up from prone costs only 5 feet of movement, climbing costs no extra movement, and you can make a running jump after moving only 5 feet.",
    "sourceHash": "5e6c1b75c350c7a92e3e30de1d1140bfd7d9b100e7d081f1414ea5334b6edd80"
  },
  {
    "id": "404f2fe1637fb18702f3",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/1/name",
    "source": "Actor",
    "sourceHash": "449995c4fe8fab389053dac72d77798c094dd4a3b7b3cfe69c4d78d119308dce"
  },
  {
    "id": "bbc07d8eaf375e559852",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/1/desc",
    "source": "Increase your Charisma by 1, to a maximum of 20. You have advantage on Deception and Performance checks when passing yourself off as someone else, and you can mimic the speech or sounds of a creature you have heard for at least 1 minute.",
    "sourceHash": "2fe0589e96961ae2f68d2045d8381aa51562d16bbbcd3b3e5e1a328585becaea"
  },
  {
    "id": "5c4f59106dfc9737467a",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/2/name",
    "source": "Charger",
    "sourceHash": "fd351654f44b394e841ad2668af4b824fab71305ee9855821dec23634b2f43a1"
  },
  {
    "id": "d91aa044d8d368eb0dd3",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/2/desc",
    "source": "After you Dash, you can use a bonus action to make one melee attack or to shove a creature. If you moved at least 10 feet in a straight line first, the attack deals an extra 5 damage or the shove pushes 10 extra feet.",
    "sourceHash": "a31b5bac37da178cbad276b787ac3b0e144eca1ea70ccdc5d7d5bf42b44b53a7"
  },
  {
    "id": "c5bc2b44f80d4739d026",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/3/name",
    "source": "Crossbow Expert",
    "sourceHash": "1b1b7f97ba4203f589d0938c967b62007e2a9e43dd017fa67b0bc4745570be08"
  },
  {
    "id": "d3977820be85e03150d3",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/3/desc",
    "source": "You ignore the loading property of crossbows you are proficient with, being within 5 feet of a hostile creature gives you no disadvantage on ranged attacks, and when you take the Attack action with a one-handed weapon you can use a bonus action to attack with a hand crossbow you are holding.",
    "sourceHash": "270b964b9701c70138a1650d6fa2c8be974c5860bd3ef5961382d7db649aacca"
  },
  {
    "id": "9f9f84294b2eac0a545d",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/4/name",
    "source": "Defensive Duelist",
    "sourceHash": "dfe5cd4e87d203c9eff3b6455de9f01b41d364aa015b9ecebbb158cb72a7faa0"
  },
  {
    "id": "5e48cb25442492f8b7ad",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/4/desc",
    "source": "When a creature hits you with a melee attack while you wield a finesse weapon you are proficient with, you can use your reaction to add your proficiency bonus to your AC against that attack, possibly turning it into a miss.",
    "sourceHash": "2694bca07e2dd3713741ea68d58c066532c0dd897521f78575b5c8a4ae6e1af0"
  },
  {
    "id": "f320be279efb4d8bb865",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/5/name",
    "source": "Dual Wielder",
    "sourceHash": "b6ed3fee6fbc2489341d701fd660359ea06010c6fbb1781814a4be2685d5916d"
  },
  {
    "id": "5696c2f51a383de95888",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/5/desc",
    "source": "You gain +1 AC while wielding a separate melee weapon in each hand, you can two-weapon fight with weapons that lack the light property, and you can draw or stow two one-handed weapons at once.",
    "sourceHash": "c5d646275667e510d2ed2174ca779295119cf3ed7ef8023515cc3d9b82d100a2"
  },
  {
    "id": "60381dfabe1e095814fe",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/6/name",
    "source": "Dungeon Delver",
    "sourceHash": "a46b3b460561f043fcfcd0c136cb21001a5b988ad0ae23052d303f80cea93696"
  },
  {
    "id": "20ae71d64c22a06d24c9",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/6/desc",
    "source": "You have advantage on Perception and Investigation checks to detect secret doors, advantage on saving throws against traps, resistance to trap damage, and you can search for traps while travelling at a normal pace.",
    "sourceHash": "5e448bccea62092739fc005de249c0202bda5d38767c3e9363b5d9494e677fb9"
  },
  {
    "id": "a5142cc815c4cf65231d",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/7/name",
    "source": "Durable",
    "sourceHash": "37c6e47e54638c39a92ff4beef364a5c857df2ae8b732997d242969f2b211d66"
  },
  {
    "id": "82b7c84b29aa10b6df2c",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/7/desc",
    "source": "Increase your Constitution by 1, to a maximum of 20. When you roll a Hit Die to regain hit points, the minimum you regain is twice your Constitution modifier.",
    "sourceHash": "3917b3a367e18b20792d8f4e9a7af0961af4da30ec579b2fbdbe8bd29d9b0f6c"
  },
  {
    "id": "dbadd87c1d08d26a6c78",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/8/name",
    "source": "Elven Accuracy",
    "sourceHash": "6fea08baf39cae15e0f8a85b0523d4f4a6f6de665686ecac997007b94342759a"
  },
  {
    "id": "ff7393b312e04a193fd8",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/8/desc",
    "source": "Increase your Dexterity, Intelligence, Wisdom, or Charisma by 1, to a maximum of 20. Whenever you have advantage on an attack roll using Dexterity, Intelligence, Wisdom, or Charisma, you can reroll one of the dice once. The server rolls a third d20 and keeps the highest.",
    "sourceHash": "8cc1499e9478c85e91e0529b202774205dd962cefdde43390d1e2941781678b4"
  },
  {
    "id": "ed51f2503168d787b2d7",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/9/name",
    "source": "Elemental Adept",
    "sourceHash": "76134691569f3277346219f079c71d97ceb1fecb8181c55a79ba8c4ddf274955"
  },
  {
    "id": "d334106174e867549456",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/9/desc",
    "source": "Choose acid, cold, fire, lightning or thunder. Your spells of that damage type ignore resistance, and any 1 rolled on their damage dice counts as a 2. You can take this feat more than once, choosing a different type each time.",
    "sourceHash": "b4b50b5db6356f5c71cea00612ceb235687e7740eb8d910b4d739078d3737a92"
  },
  {
    "id": "1c7d00adc93262efae32",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/10/name",
    "source": "Great Weapon Master",
    "sourceHash": "6889b36a14de3d4029e187bfdbd5220ab5eed263e451d0e7d0007c26009683d7"
  },
  {
    "id": "8a489729f7094d1a860f",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/10/desc",
    "source": "On a critical hit or when you drop a creature to 0 hit points with a melee weapon, you can make one melee weapon attack as a bonus action. Before attacking with a heavy weapon you are proficient with, you can take a -5 penalty to the attack roll in exchange for +10 damage on a hit.",
    "sourceHash": "300a30248bb203dc45c45570e4086236e75d3113462f56aa4f64284eaae105c4"
  },
  {
    "id": "1a59e96659a9d56c5113",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/11/name",
    "source": "Healer",
    "sourceHash": "a491a33c72cd4d182ee8ede3507d1742252d8953b036d7cad05c174e39f1806d"
  },
  {
    "id": "de6124d7fd6edf50ace2",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/11/desc",
    "source": "When you stabilize a creature with a healer's kit it also regains 1 hit point. As an action you can spend a use of a healer's kit to restore 1d6 + 4 hit points plus the creature's Hit Dice to a creature, once each per rest.",
    "sourceHash": "91be4bce3b5a9b896d3392a3b66b44093a9e95e9b674c490d24a20c122c5e54d"
  },
  {
    "id": "b53836496d78f892181f",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/12/name",
    "source": "Heavily Armored",
    "sourceHash": "2a5f640641c8d25e6bc4b7ae0743f83321aa1fc5035851723d513761b698a1c5"
  },
  {
    "id": "8584d54db8c108148542",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/12/desc",
    "source": "Increase your Strength by 1, to a maximum of 20, and gain proficiency with heavy armor.",
    "sourceHash": "896870e8e2127e7d3b4397f3d593db6c46a9be8854b05c0a1cddb9e227036a5c"
  },
  {
    "id": "9be9dad6792bab79feae",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/13/name",
    "source": "Heavy Armor Master",
    "sourceHash": "2b8c805a215d88605a608a2e6b8a1d03b8d368863c22b30d796556781ea6a644"
  },
  {
    "id": "0d30ebc8a613886d823a",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/13/desc",
    "source": "Increase your Strength by 1, to a maximum of 20. While you wear heavy armor, bludgeoning, piercing and slashing damage from nonmagical attacks is reduced by 3.",
    "sourceHash": "bc0d8498e96db34835201203bce1bd2fc4ed7306fa8f6dbac6e0a53cb9f88db3"
  },
  {
    "id": "9e4d62ff95edef736208",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/14/name",
    "source": "Inspiring Leader",
    "sourceHash": "179818cdd728d405e354f3ca1f3377d931a3026dbd22f2922ff39af7cd88803f"
  },
  {
    "id": "b599521a518448128223",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/14/desc",
    "source": "You can spend 10 minutes rallying up to six friendly creatures within 30 feet who can hear and understand you. Each gains temporary hit points equal to your level plus your Charisma modifier, and cannot benefit again until it finishes a rest.",
    "sourceHash": "e60d9f47384c371e531806307f91633ce2a12166d4d79d11e3e6032eb7b8cc37"
  },
  {
    "id": "37ac08c854df0db9d7bb",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/15/name",
    "source": "Keen Mind",
    "sourceHash": "d58d251be06899e834feec89137c350ccfacb079349e01b7a276656d80ff04f2"
  },
  {
    "id": "cb79a77ad58398a65820",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/15/desc",
    "source": "Increase your Intelligence by 1, to a maximum of 20. You always know which way is north and how many hours remain before sunrise or sunset, and you accurately recall anything you have seen or heard in the past month.",
    "sourceHash": "9934817b6151d3b1689d46e76b028d27f5bd8edbc5c25fc0189be594f0090599"
  }
]
