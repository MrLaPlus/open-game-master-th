[
  {
    "id": "9a15cf8cb9ebcb70f149",
    "source": "For a dragonborn; rolled on the SRD table when left unset.",
    "sourceHash": "9a15cf8cb9ebcb70f149da4185854aff28c4617035ef033e26cf3d9e66aff72e",
    "kinds": [
      "display-property"
    ],
