  {
    "id": "d868511cdb102a46fc27",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/0/desc",
    "source": "Increase your Strength or Dexterity by 1, to a maximum of 20. Standing up from prone costs only 5 feet of movement, climbing costs no extra movement, and you can make a running jump after moving only 5 feet.",
    "sourceHash": "5e6c1b75c350c7a92e3e30de1d1140bfd7d9b100e7d081f1414ea5334b6edd80"
  },
  {
    "id": "bbc07d8eaf375e559852",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/1/desc",
    "source": "Increase your Charisma by 1, to a maximum of 20. You have advantage on Deception and Performance checks when passing yourself off as someone else, and you can mimic the speech or sounds of a creature you have heard for at least 1 minute.",
    "sourceHash": "2fe0589e96961ae2f68d2045d8381aa51562d16bbbcd3b3e5e1a328585becaea"
  },
  {
    "id": "d91aa044d8d368eb0dd3",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/2/desc",
    "source": "After you Dash, you can use a bonus action to make one melee attack or to shove a creature. If you moved at least 10 feet in a straight line first, the attack deals an extra 5 damage or the shove pushes 10 extra feet.",
    "sourceHash": "a31b5bac37da178cbad276b787ac3b0e144eca1ea70ccdc5d7d5bf42b44b53a7"
  },
  {
    "id": "d3977820be85e03150d3",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/3/desc",
    "source": "You ignore the loading property of crossbows you are proficient with, being within 5 feet of a hostile creature gives you no disadvantage on ranged attacks, and when you take the Attack action with a one-handed weapon you can use a bonus action to attack with a hand crossbow you are holding.",
    "sourceHash": "270b964b9701c70138a1650d6fa2c8be974c5860bd3ef5961382d7db649aacca"
  },
  {
    "id": "5e48cb25442492f8b7ad",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/4/desc",
    "source": "When a creature hits you with a melee attack while you wield a finesse weapon you are proficient with, you can use your reaction to add your proficiency bonus to your AC against that attack, possibly turning it into a miss.",
    "sourceHash": "2694bca07e2dd3713741ea68d58c066532c0dd897521f78575b5c8a4ae6e1af0"
  },
  {
    "id": "5696c2f51a383de95888",
    "sourceFile": "src/lib/srd/authored-feats.json",
    "pointer": "/feats/5/desc",
    "source": "You gain +1 AC while wielding a separate melee weapon in each hand, you can two-weapon fight with weapons that lack the light property, and you can draw or stow two one-handed weapons at once.",
    "sourceHash": "c5d646275667e510d2ed2174ca779295119cf3ed7ef8023515cc3d9b82d100a2"
  }
]
