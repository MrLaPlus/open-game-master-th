  },
  {
    "id": "6d244e253765fea17971",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/artificer/3/levels/5/0/d",
    "source": "Attack twice whenever you take the Attack action.",
    "sourceHash": "4759d50b11249375c68f4fd4769b3518b694257600421b6362377a7cd6c64e7c"
  },
  {
    "id": "cc96e7405f82ebeee3e8",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/artificer/3/levels/9/0/n",
