    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/artificer/2/levels/9/0/d",
    "source": "Your cannon deals an extra 1d8, and you can detonate it as an action for 3d8 force damage in a 20-foot radius, halved on a successful Dexterity save.",
    "sourceHash": "71061a914a83e330658865ca34dc8a80ab71ad3f088939a284a61cef3cf46955"
  },
  {
    "id": "415cd40b9e7985d61be9",
