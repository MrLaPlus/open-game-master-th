    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/artificer/2/levels/15/0/d",
    "source": "You can have two cannons at once, and you and your allies have half cover within 10 feet of one.",
    "sourceHash": "5aa2cf9f1b64c5b637bd367888b31205419c006115b1ec005c3092ab6a5197e8"
  },
