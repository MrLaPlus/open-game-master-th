    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/artificer/2/levels/5/0/d",
    "source": "A wand, staff or rod becomes your firearm, adding 1d8 to one damage roll of each artificer spell you cast through it.",
    "sourceHash": "b10a8f04c88958e9b6780c8d7f1b1657a0f77e817d3f8462883ec5236066a950"
  },
  {
