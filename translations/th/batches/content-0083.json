    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/artificer/3/levels/3/1/d",
    "source": "Proficiency with martial weapons, and you use Intelligence instead of Strength or Dexterity for attack and damage with magic weapons.",
