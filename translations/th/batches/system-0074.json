        "line": 156
      }
    ]
  },
  {
    "id": "2f26a12aa30fe6897c23",
    "source": "Keep the party backstory under {0} characters.",
    "sourceHash": "2f26a12aa30fe6897c23a69263cd99bc07361630bb3e8bc20301fd640fbc914d",
    "kinds": [
      "template-property"
    ],
    "sites": [
