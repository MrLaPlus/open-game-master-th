    "source": "Path of the Storm Herald",
    "sourceHash": "99a7e1149e332736ffd1490bb9818578810bf5edc7ebe46d746a96d07fb97f15"
  },
  {
    "id": "7e95a87575c5928c9320",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/barbarian/2/desc",
    "source": "Rage manifests as a 10-foot aura of desert heat, arctic cold, or sea storm.",
