      }
    ]
  },
  {
    "id": "ceac1eebefc2773e14b4",
    "source": "Open Game Master is an open source (MIT licensed), self-hosted application. You run it on your own server, or on your own phone or computer, and your data stays there. The creator of Open Game Master does not collect, sell, or share any user data, and has no access to the data on any server or device running the app. The one exception is described under &quot;Sharing a world from your device&quot; below.",
    "sourceHash": "ceac1eebefc2773e14b46d59aaf91d031ca2056cffd5abe653720bc24b1255bd",
    "kinds": [
      "jsx-text"
