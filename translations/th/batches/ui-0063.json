      }
    ]
  },
  {
    "id": "35774dab972e53d0bae8",
    "source": "Open Game Master is a self-hosted, multiplayer Dungeons &amp; Dragons 5e platform run by an AI Game Master. Server admins manage users, models, images, voice and campaign plugins from the Admin panel. Game content comes from the SRD 5.1 and Open5e; see",
    "sourceHash": "35774dab972e53d0bae87a64a79cc71ca67b0abdcad3b10fc42fa6d7da923e86",
    "kinds": [
      "jsx-text"
