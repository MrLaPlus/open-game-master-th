    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/1/desc",
    "source": "A fighter who braids wizard magic into swordplay, casting and striking in the same breath.",
    "sourceHash": "6bd1b8bdf50d69d4dfcd7b3b7ee436b9b6ec8461be54d747b95625d3693c269f"
  },
  {
