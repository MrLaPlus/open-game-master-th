    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/1/levels/3/0/n",
    "source": "Spellcasting (Eldritch Knight)",
    "sourceHash": "427ca97f8ae7e18e4916d9a327860ee4bcfb2c64c6071a3ac82231803d54e28d"
  },
  {
    "id": "1d23941efa15494ec56c",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/1/levels/3/0/d",
    "source": "Third-caster wizard spellcasting keyed to Intelligence, drawn mostly from abjuration and evocation.",
    "sourceHash": "1d964cc5382a994631a8dae436d4e59759943fcb0e562136f5f491bb5d47dd69"
  },
  {
    "id": "977e41cfda34e3ade626",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/1/levels/3/1/n",
    "source": "Weapon Bond",
    "sourceHash": "e701df4fed58f232e280ca9cc04eccccf0b16d27f1468137f01fe7fe70f68207"
  },
  {
    "id": "f3f6618769c9d7277235",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/1/levels/3/1/d",
    "source": "Bond up to two weapons in an hour-long ritual: you cannot be disarmed of them and can summon one to your hand as a bonus action.",
    "sourceHash": "7481c389d942d0ec14252d39a335418879d8ef3f21183a6d451d13b27d9280ec"
  },
  {
