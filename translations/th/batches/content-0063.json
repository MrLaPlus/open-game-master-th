    "sourceHash": "20c56bfb6b54a998afbae971799487530c38915140258edd03bc07bab5c6736f"
  },
  {
    "id": "923fda4bb41e458a01ad",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/0/desc",
    "source": "A student of martial technique who spends superiority dice on precise, tide-turning maneuvers.",
    "sourceHash": "78996678ffccc1a5af7b6b957e467b83c702d9852dfa1ce8f4e7e636d47d99d7"
  },
  {
    "id": "be1d47b6f3ecf2094e4f",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/0/levels/3/0/n",
    "source": "Combat Superiority",
    "sourceHash": "63048942d83fec5d74459a5e104bcf936982be2bcee8640039e1a0098755b472"
  },
  {
    "id": "e2ab2597cb00fbf9a2d1",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/0/levels/3/0/d",
    "source": "Four superiority dice of d8 (five at 7th level, six at 15th), regained on a short or long rest, spent on maneuvers whose save DC is 8 + your proficiency bonus + your Strength or Dexterity modifier.",
    "sourceHash": "5f93e13c67b2073c7938ac4e550fced4f48338addce66f5f9885d4f05b41a8d7"
  },
  {
