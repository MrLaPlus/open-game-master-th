    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/0/levels/3/1/n",
    "source": "Maneuvers",
    "sourceHash": "3291bfc0e42ef5906d5c9b574edc9c401e25889aae27f5b9a12455409a265f07"
  },
  {
    "id": "caaf76cacd31117c547a",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/0/levels/3/1/d",
    "source": "Three maneuvers known, such as Trip Attack, Disarming Attack, Riposte, Precision Attack, Menacing Attack and Commander's Strike, rising to five known at 7th level, seven at 10th and nine at 15th.",
    "sourceHash": "555af95506ee4d2b6abb9d50ecccccf82c5a197b35a4731b7a8eebba65c9492f"
  },
