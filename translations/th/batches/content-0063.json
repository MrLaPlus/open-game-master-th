    "sourceHash": "2f15443ddf3db60ac9fa508437bb126aa91f96144303eb27e3ca987fe1023f37"
  },
  {
    "id": "0c7457154f917df7c669",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/1/name",
    "source": "Eldritch Knight",
