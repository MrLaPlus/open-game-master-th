    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/fighter/0/levels/3/2/d",
    "source": "Proficiency with one kind of artisan's tools.",
    "sourceHash": "c441a51bc2329193507329d56a668c29e0b8322b6c1d77f0868e322841c6e558"
  },
  {
