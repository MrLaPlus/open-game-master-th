    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/barbarian/5/levels/10/0/d",
    "source": "When you take damage or fail a save while raging, a reaction rerolls your Wild Surge effect.",
    "sourceHash": "d9adf328fc46a4a0a5c093caf79b51177fc2fabec6d7110a9a279e4e401d349b"
  },
