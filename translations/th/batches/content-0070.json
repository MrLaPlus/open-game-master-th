    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/ranger/0/levels/7/0/d",
    "source": "On a turn your companion doesn't attack, a bonus action can command it to Dash, Disengage or Help, and its attacks are magical for overcoming resistance and immunity to nonmagical attacks.",
    "sourceHash": "50cacd85b71540a2037df129668fda930045778e577567fd15fccc87e393e414"
  },
