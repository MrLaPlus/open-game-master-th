    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/rogue/6/levels/3/1/d",
    "source": "After a sneak attack drops or wounds a creature, a second creature within 30 feet takes half your sneak attack dice in necrotic damage; a proficiency-bonus number of times per long rest.",
    "sourceHash": "e93ccea8b0c19424575236ffea52808a37966223640d5d5c1a3011965b6d89a5"
  },
  {
    "id": "9f28f771338b1b5b106c",
    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/rogue/6/levels/9/0/n",
    "source": "Tokens of the Departed",
