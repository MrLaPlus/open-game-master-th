    "sourceFile": "src/lib/srd/subclasses.json",
    "pointer": "/classes/rogue/6/levels/13/0/d",
    "source": "A bonus action makes you spectral for 10 minutes with a 10-foot fly speed and the ability to move through creatures and objects; free once per long rest, otherwise costs a soul trinket.",
    "sourceHash": "6e5cd2c4e34188d751b774a5091f4f3c272552a21db24c79c63d2908803c13e3"
  },
  {
