      }
    ]
  },
  {
    "id": "f43470db08f06f680ad9",
    "source": "You can stop using the software at any time, delete your account and content from within the app, or delete the whole database from your server. An operator can shut a server down at any time, with or without notice, and the campaigns on it go with it.",
    "sourceHash": "f43470db08f06f680ad95ef4a784fb4fbb791173e79035408f39dcfb899de46e",
    "kinds": [
      "jsx-text"
